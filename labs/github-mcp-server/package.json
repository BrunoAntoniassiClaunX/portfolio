{
  "name": "github-mcp-server",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server that reads public GitHub repository metadata over stdio (portfolio lab).",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-timeout=20000 \"test/*.test.js\"",
    "test:live": "node --test --test-timeout=30000 \"test/live/*.test.js\"",
    "test:container": "node --test --test-timeout=60000 \"test/container/*.test.js\"",
    "test:container:live": "node --test --test-timeout=60000 \"test/container/live/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
